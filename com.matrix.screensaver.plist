<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.matrix.screensaver</string>

    <key>ProgramArguments</key>
    <array>
        <string>/Users/miketunis/.matrix_screensaver/MatrixScreensaver</string>
        <string>--daemon</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/miketunis/.matrix_screensaver</string>

    <key>RunAtLoad</key>
    <true/>

    <key>KeepAlive</key>
    <true/>

    <key>ThrottleInterval</key>
    <integer>10</integer>

    <key>StandardOutPath</key>
    <string>/tmp/matrix_screensaver.log</string>

    <key>StandardErrorPath</key>
    <string>/tmp/matrix_screensaver_error.log</string>
</dict>
</plist>
